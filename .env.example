VAEZIN_START_URL=https://vaezin.com/
VAEZIN_MAX_PAGE=0
VAEZIN_TIMEOUT=3
VAEZIN_STATE_FILE=state/vaezin.json
VAEZIN_SOURCE=vaezin.com

